# Add / change these in the .env that Laravel generates

APP_NAME="JOPLC IT Service Desk"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://itsm.joplc.local
APP_TIMEZONE=Asia/Dhaka

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=joplc_itsm
DB_USERNAME=itsm
DB_PASSWORD=change-me

# Session timeout in minutes, expire when browser closes, HTTPS-only cookies
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true

# First administrator password used by DatabaseSeeder (change after first login)
ITSM_ADMIN_PASSWORD=ChangeMe@12345
